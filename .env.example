# Copy this file to .env, then paste the same pooled Supabase database URL
# used by QCC Control Tower. URL-encode special characters in the password.
QCC_SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Required for private Google Workspace and Microsoft 365 sign-in.
QCC_SUPABASE_URL=https://PROJECT_REF.supabase.co
QCC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
QCC_PUBLIC_APP_URL=http://localhost:3000
